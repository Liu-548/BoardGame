{
  "name": "bang-boardgame",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-07-25",
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] }
  ],
  // Phục vụ file client đã build (npm run build -> dist/) CHUNG domain với
  // Worker. "run_worker_first": ["/room/*"] nghĩa là đường dẫn /room/... LUÔN
  // chạy Worker trước (xử lý WebSocket/API phòng), còn lại (/, /assets/...)
  // phục vụ thẳng file tĩnh trong dist/, không chạy Worker cho nhanh.
  "assets": {
    "directory": "./dist",
    "run_worker_first": ["/room/*"]
  }
}
